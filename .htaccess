# ==================================================================
#  Réglages du serveur — Institut Sacré Cœur d'Adjamé
#  ------------------------------------------------------------------
#  Ce fichier est lu par Apache et par LiteSpeed, le serveur utilisé
#  par Hostinger. Il n'a aucun effet sur GitHub Pages, qui l'ignore.
#
#  Chaque bloc est protégé par un « IfModule » : si le module n'est pas
#  disponible sur l'hébergement, le bloc est sauté au lieu de faire
#  tomber le site avec une erreur 500.
# ==================================================================

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# ------------------------------------------------------------------
#  1. Tout passe en HTTPS
#  Les identifiants des enseignants et des parents circulent sur ces
#  pages. En clair, ils seraient lisibles par qui partage le réseau.
#  Le site appelle par ailleurs son serveur applicatif sur sa propre
#  origine : servi en http, il n'atteindrait pas un back-end en https.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
#  2. Compression
#  Les feuilles de style pèsent 240 Ko brutes et moins de 70 Ko
#  compressées. Sans ce bloc, on envoie plus de trois fois trop.
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ------------------------------------------------------------------
#  3. Durée de conservation dans le navigateur
#  Les feuilles et les scripts portent un numéro de version dans leur
#  adresse (« ?v=… ») : on peut donc les garder longtemps, puisqu'une
#  nouvelle version change l'adresse. Les pages, elles, ne sont pas
#  versionnées — elles ne doivent jamais rester en cache, sinon une
#  correction resterait invisible pour les visiteurs déjà venus.
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType application/pdf           "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------
#  4. En-têtes de sécurité — les trois qui coûtent le moins et
#  protègent le plus.
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Le navigateur respecte le type déclaré et n'essaie pas de deviner.
  Header set X-Content-Type-Options "nosniff"
  # Le site ne peut pas être encadré dans une page tierce.
  Header set X-Frame-Options "SAMEORIGIN"
  # On ne transmet pas l'adresse complète de la page aux sites visités.
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------
#  5. GARDE-FOU
#  Le dossier publié ne contient aucun document interne — l'outil de
#  publication ne recopie que ce que les pages affichent. Ce blocage
#  est là pour le jour où quelqu'un téléverserait le dossier de travail
#  par mégarde : les documents Word d'origine, l'enregistrement de la
#  réunion pédagogique et les états d'élèves resteraient inaccessibles.
# ------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "\.(docx|doc|xlsx|xls|mp3|mp4|wav|env|db|sqlite|log|bak)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/Doc/
  RedirectMatch 404 (?i)/_Sauvegardes/
  RedirectMatch 404 (?i)/outils/
</IfModule>

# Le listing d'un dossier sans index ne doit rien révéler.
Options -Indexes
