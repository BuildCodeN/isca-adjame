# ==================================================================
#  Réglages du serveur — Institut Sacré Cœur d'Adjamé
#  ------------------------------------------------------------------
#  Ce fichier est lu par Apache et par LiteSpeed, le serveur utilisé
#  par Hostinger. Il n'a aucun effet sur GitHub Pages, qui l'ignore.
#
#  Chaque bloc est protégé par un « IfModule » : si le module n'est pas
#  disponible sur l'hébergement, le bloc est sauté au lieu de faire
#  tomber le site avec une erreur 500.
# ==================================================================

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# ------------------------------------------------------------------
#  1. Tout passe en HTTPS
#  Les identifiants des enseignants et des parents circulent sur ces
#  pages. En clair, ils seraient lisibles par qui partage le réseau.
#  Le site appelle par ailleurs son serveur applicatif sur sa propre
#  origine : servi en http, il n'atteindrait pas un back-end en https.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
# CONSTAT (test d'intrusion du 18/11/2026) : en ligne, http://isca-adjame.com répond 200 au lieu
# d'une redirection 301 — la règle ci-dessus ne semble jamais atteinte, probablement parce que le
# CDN de l'hébergeur (en-tête « server: hcdn ») sert certaines requêtes HTTP sans les faire passer
# par Apache/LiteSpeed et ce .htaccess. Vérifier dans hPanel qu'une option « Forcer HTTPS » existe
# au niveau du CDN/SSL et l'activer : c'est la correction qui compte vraiment. L'en-tête HSTS
# ci-dessous (bloc 4) est un filet de secours qui, lui, est confirmé actif.

# ------------------------------------------------------------------
#  2. Compression
#  Les feuilles de style pèsent 240 Ko brutes et moins de 70 Ko
#  compressées. Sans ce bloc, on envoie plus de trois fois trop.
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ------------------------------------------------------------------
#  3. Durée de conservation dans le navigateur
#  Les feuilles et les scripts portent un numéro de version dans leur
#  adresse (« ?v=… ») : on peut donc les garder longtemps, puisqu'une
#  nouvelle version change l'adresse. Les pages, elles, ne sont pas
#  versionnées — elles ne doivent jamais rester en cache, sinon une
#  correction resterait invisible pour les visiteurs déjà venus.
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType application/pdf           "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------
#  4. En-têtes de sécurité — les trois qui coûtent le moins et
#  protègent le plus, complétés le 18/11/2026 après un test d'intrusion.
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Le navigateur respecte le type déclaré et n'essaie pas de deviner.
  Header set X-Content-Type-Options "nosniff"
  # Le site ne peut pas être encadré dans une page tierce.
  Header set X-Frame-Options "SAMEORIGIN"
  # On ne transmet pas l'adresse complète de la page aux sites visités.
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Une fois le visiteur venu une fois en https, son navigateur n'essaiera plus jamais le http
  # pour ce domaine (un an, sous-domaines compris) — même si la redirection 301 du bloc 1 ne
  # s'applique pas (voir le constat plus haut), ceci protège dès la première visite en https.
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Politique resserrée : scripts et appels uniquement vers le site lui-même, aucune page tierce
  # ne peut nous encadrer, aucun <object>/<embed>, aucun formulaire qui soumettrait ailleurs.
  # 'unsafe-inline' reste nécessaire pour les quelques onclick="" et balises <style> existants
  # (aucun script tiers n'est chargé : le vrai gain est de bloquer tout code injecté qui tenterait
  # de charger une ressource depuis un autre domaine).
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self'; frame-src https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # Ne pas annoncer la version exacte de PHP (information inutile offerte à qui chercherait une
  # faille connue d'une version précise).
  Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------
#  5. GARDE-FOU
#  Le dossier publié ne contient aucun document interne — l'outil de
#  publication ne recopie que ce que les pages affichent. Ce blocage
#  est là pour le jour où quelqu'un téléverserait le dossier de travail
#  par mégarde : les documents Word d'origine, l'enregistrement de la
#  réunion pédagogique et les états d'élèves resteraient inaccessibles.
# ------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "\.(docx|doc|xlsx|xls|mp3|mp4|wav|env|db|sqlite|log|bak|sql)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/Doc/
  RedirectMatch 404 (?i)/_Sauvegardes/
  RedirectMatch 404 (?i)/outils/
</IfModule>

# Le listing d'un dossier sans index ne doit rien révéler.
Options -Indexes
